{%- comment -%}
  Resumen de compra para 2 productos.
  El boton "Pagar ahora" arma un enlace de carrito (/cart/VARIANTE:CANTIDAD,...)
  que reemplaza el carrito y abre el checkout real de Shopify.
{%- endcomment -%}

<div class="tpc" data-tpc data-currency="{{ cart.currency.iso_code }}" data-locale="{{ request.locale.iso_code }}">
  <div class="tpc__card">
    {%- if section.settings.heading != blank -%}
      <h2 class="tpc__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul class="tpc__products">
      {%- for i in (1..2) -%}
        {%- liquid
          if i == 1
            assign product = section.settings.product_1
          else
            assign product = section.settings.product_2
          endif
        -%}
        {%- if product != blank -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          <li class="tpc__product" data-tpc-product>
            <div class="tpc__thumb">
              {%- assign image = variant.featured_image | default: product.featured_image -%}
              {%- if image -%}
                {{ image | image_url: width: 160 | image_tag: alt: product.title, loading: 'lazy', data-tpc-image: '' }}
              {%- endif -%}
              <span class="tpc__badge" data-tpc-badge>1</span>
            </div>

            <div class="tpc__info">
              <p class="tpc__name">{{ product.title }}</p>

              {%- if product.has_only_default_variant -%}
                <input type="hidden" data-tpc-variant value="{{ variant.id }}"
                  data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price }}">
              {%- else -%}
                <select class="tpc__select" data-tpc-variant aria-label="{{ product.title }}">
                  {%- for v in product.variants -%}
                    <option value="{{ v.id }}"
                      data-price="{{ v.price }}"
                      data-compare="{{ v.compare_at_price }}"
                      {% if v.featured_image %}data-image="{{ v.featured_image | image_url: width: 160 }}"{% endif %}
                      {% unless v.available %}disabled{% endunless %}
                      {% if v.id == variant.id %}selected{% endif %}>
                      {{ v.title }}{% unless v.available %} — Agotado{% endunless %}
                    </option>
                  {%- endfor -%}
                </select>
              {%- endif -%}

              <div class="tpc__stepper">
                <button type="button" data-tpc-step="-1" aria-label="Quitar uno">−</button>
                <span data-tpc-qty>1</span>
                <button type="button" data-tpc-step="1" aria-label="Agregar uno">+</button>
              </div>
            </div>

            <div class="tpc__price">
              <s data-tpc-compare></s>
              <span data-tpc-line></span>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.product_1 == blank and section.settings.product_2 == blank -%}
      <p class="tpc__empty">Elige los 2 productos en la configuración de esta sección.</p>
    {%- endif -%}

    <div class="tpc__discount">
      <input type="text" data-tpc-discount placeholder="Código de descuento" autocomplete="off">
    </div>

    <dl class="tpc__totals">
      <div><dt>Subtotal · <span data-tpc-count></span></dt><dd data-tpc-subtotal></dd></div>
      <div class="tpc__savings" data-tpc-savings-row hidden><dt>Ahorras</dt><dd data-tpc-savings></dd></div>
      <div><dt>Envío</dt><dd class="tpc__muted">Se calcula en el siguiente paso</dd></div>
      <div class="tpc__total"><dt>Total</dt><dd><small>{{ cart.currency.iso_code }}</small> <strong data-tpc-total></strong></dd></div>
    </dl>

    <a class="tpc__pay" href="#" data-tpc-pay>{{ section.settings.button_label }}</a>
    <p class="tpc__secure">🔒 Todas las transacciones son seguras y están encriptadas.</p>
  </div>
</div>

{% stylesheet %}
  .tpc {
    --tpc-accent: #1773b0;
    --tpc-border: #dedede;
    --tpc-muted: #707070;
    padding: 40px 16px;
  }
  .tpc__card {
    max-width: 520px;
    margin: 0 auto;
    padding: 28px;
    border: 1px solid var(--tpc-border);
    border-radius: 12px;
    background: #f5f5f5;
    color: #000;
    font-size: 14px;
  }
  .tpc__heading {
    margin: 0 0 20px;
    font-size: 21px;
  }
  .tpc__products {
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
  }
  .tpc__product {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }
  .tpc__thumb {
    position: relative;
    flex-shrink: 0;
    width: 64px;
    height: 64px;
  }
  .tpc__thumb img {
    width: 100%;
    height: 100%;
    border: 1px solid var(--tpc-border);
    border-radius: 8px;
    background: #fff;
    object-fit: cover;
  }
  .tpc__badge {
    position: absolute;
    top: -8px;
    right: -8px;
    display: grid;
    place-items: center;
    min-width: 21px;
    height: 21px;
    padding: 0 6px;
    border-radius: 11px;
    background: rgba(0, 0, 0, 0.85);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
  }
  .tpc__info {
    flex: 1;
    min-width: 0;
  }
  .tpc__name {
    margin: 0 0 4px;
    font-weight: 500;
  }
  .tpc__select {
    display: block;
    max-width: 100%;
    margin-bottom: 6px;
    padding: 4px 6px;
    border: 1px solid var(--tpc-border);
    border-radius: 5px;
    background: #fff;
    font: inherit;
    font-size: 13px;
  }
  .tpc__stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--tpc-border);
    border-radius: 5px;
    background: #fff;
  }
  .tpc__stepper button {
    width: 28px;
    height: 26px;
    border: 0;
    background: none;
    font-size: 15px;
    cursor: pointer;
  }
  .tpc__stepper span {
    min-width: 20px;
    text-align: center;
  }
  .tpc__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .tpc__price s {
    color: var(--tpc-muted);
    font-size: 12px;
  }
  .tpc__discount input {
    width: 100%;
    height: 48px;
    padding: 0 12px;
    border: 1px solid var(--tpc-border);
    border-radius: 5px;
    background: #fff;
    font: inherit;
  }
  .tpc__totals {
    margin: 20px 0;
  }
  .tpc__totals > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }
  .tpc__totals > div[hidden] {
    display: none;
  }
  .tpc__totals dt,
  .tpc__totals dd {
    margin: 0;
  }
  .tpc__muted,
  .tpc__total small {
    color: var(--tpc-muted);
    font-size: 12px;
  }
  .tpc__savings dd {
    color: #2e7d32;
  }
  .tpc__total {
    align-items: baseline;
    margin-top: 14px;
    font-size: 19px;
    font-weight: 600;
  }
  .tpc__pay {
    display: block;
    padding: 16px;
    border-radius: 5px;
    background: var(--tpc-accent);
    color: #fff;
    font-size: 18px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }
  .tpc__pay[aria-disabled='true'] {
    opacity: 0.5;
    pointer-events: none;
  }
  .tpc__secure,
  .tpc__empty {
    margin: 12px 0 0;
    color: var(--tpc-muted);
    font-size: 13px;
    text-align: center;
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-tpc]').forEach((root) => {
    const money = (cents) =>
      new Intl.NumberFormat(root.dataset.locale, { style: 'currency', currency: root.dataset.currency }).format(cents / 100);

    const items = [...root.querySelectorAll('[data-tpc-product]')].map((el) => ({ el, qty: 1 }));

    const selected = (item) => {
      const input = item.el.querySelector('[data-tpc-variant]');
      const source = input.tagName === 'SELECT' ? input.selectedOptions[0] : input;
      return {
        id: input.value,
        price: Number(source.dataset.price) || 0,
        compare: Number(source.dataset.compare) || 0,
        image: source.dataset.image,
      };
    };

    function render() {
      let count = 0, subtotal = 0, savings = 0;
      const parts = [];

      items.forEach((item) => {
        const v = selected(item);
        const line = v.price * item.qty;
        const compareLine = v.compare > v.price ? v.compare * item.qty : 0;

        item.el.querySelector('[data-tpc-qty]').textContent = item.qty;
        item.el.querySelector('[data-tpc-badge]').textContent = item.qty;
        item.el.querySelector('[data-tpc-line]').textContent = money(line);
        item.el.querySelector('[data-tpc-compare]').textContent = compareLine ? money(compareLine) : '';
        item.el.style.opacity = item.qty ? 1 : 0.5;

        count += item.qty;
        subtotal += line;
        if (compareLine) savings += compareLine - line;
        if (item.qty) parts.push(`${v.id}:${item.qty}`);
      });

      root.querySelector('[data-tpc-count]').textContent = `${count} ${count === 1 ? 'artículo' : 'artículos'}`;
      root.querySelector('[data-tpc-subtotal]').textContent = money(subtotal);
      root.querySelector('[data-tpc-total]').textContent = money(subtotal);
      root.querySelector('[data-tpc-savings-row]').hidden = !savings;
      root.querySelector('[data-tpc-savings]').textContent = money(savings);

      // Enlace de carrito: reemplaza el carrito con estos productos y abre el checkout
      const code = root.querySelector('[data-tpc-discount]').value.trim();
      const pay = root.querySelector('[data-tpc-pay]');
      pay.href = parts.length ? `/cart/${parts.join(',')}${code ? `?discount=${encodeURIComponent(code)}` : ''}` : '#';
      pay.setAttribute('aria-disabled', parts.length ? 'false' : 'true');
    }

    items.forEach((item) => {
      item.el.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-tpc-step]');
        if (!btn) return;
        item.qty = Math.max(0, Math.min(99, item.qty + Number(btn.dataset.tpcStep)));
        render();
      });

      const select = item.el.querySelector('select[data-tpc-variant]');
      if (select) {
        select.addEventListener('change', () => {
          const image = selected(item).image;
          const img = item.el.querySelector('img');
          if (image && img) {
            img.src = image;
            img.removeAttribute('srcset');
          }
          render();
        });
      }
    });

    root.querySelector('[data-tpc-discount]').addEventListener('input', render);
    render();
  });
{% endjavascript %}

{% schema %}
{
  "name": "Checkout 2 productos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Resumen del pedido"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Producto 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Producto 2"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Pagar ahora"
    }
  ],
  "presets": [
    {
      "name": "Checkout 2 productos"
    }
  ]
}
{% endschema %}
