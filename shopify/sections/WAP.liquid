{%- comment -%}
  WAP Landing: pagina de un solo producto.
  Portada, barra de beneficios, tarjetas, caja de compra, pasos de uso,
  resenas, comparacion, preguntas frecuentes y llamado final.
  Todo se edita desde el editor del tema (secciones y bloques).
{%- endcomment -%}

{%- assign product_item = section.settings.product -%}
{%- assign variant = product_item.selected_or_first_available_variant -%}
{%- assign hero_image = section.settings.hero_image | default: product_item.featured_image -%}

<div
  class="wap"
  style="--wap-accent: {{ section.settings.accent }}; --wap-soft: {{ section.settings.soft }}; --wap-dark: {{ section.settings.dark }};"
  data-wap
  data-currency="{{ cart.currency.iso_code }}"
  data-locale="{{ request.locale.iso_code }}"
>

  {%- comment -%} ===== PORTADA ===== {%- endcomment -%}
  <div class="wap-hero">
    <span class="wap-bubble wap-bubble--1" aria-hidden="true"></span>
    <span class="wap-bubble wap-bubble--2" aria-hidden="true"></span>
    <span class="wap-bubble wap-bubble--3" aria-hidden="true"></span>
    <span class="wap-bubble wap-bubble--4" aria-hidden="true"></span>

    <div class="wap-wrap wap-hero__grid">
      <div class="wap-hero__copy" data-wap-reveal>
        {%- if section.settings.rating_text != blank -%}
          <p class="wap-rating"><span class="wap-stars">★★★★★</span> {{ section.settings.rating_text }}</p>
        {%- endif -%}
        {%- if section.settings.eyebrow != blank -%}
          <p class="wap-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="wap-hero__title">{{ section.settings.heading }}</h1>
        {%- if section.settings.subheading != blank -%}
          <div class="wap-hero__text">{{ section.settings.subheading }}</div>
        {%- endif -%}
        <div class="wap-hero__actions">
          <a class="wap-btn" href="#wap-comprar">{{ section.settings.hero_button }}</a>
          {%- if product_item != blank -%}
            <span class="wap-hero__price">{{ variant.price | money }}</span>
          {%- endif -%}
        </div>
        <ul class="wap-checks">
          {%- if section.settings.check_1 != blank -%}<li>{{ section.settings.check_1 }}</li>{%- endif -%}
          {%- if section.settings.check_2 != blank -%}<li>{{ section.settings.check_2 }}</li>{%- endif -%}
          {%- if section.settings.check_3 != blank -%}<li>{{ section.settings.check_3 }}</li>{%- endif -%}
        </ul>
      </div>

      <div class="wap-hero__media" data-wap-reveal style="--wap-delay: 200ms;">
        <div class="wap-hero__frame">
          {%- if hero_image -%}
            {{ hero_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 45vw, 90vw', class: 'wap-hero__img', alt: product_item.title }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ===== BARRA DE BENEFICIOS ===== {%- endcomment -%}
  {%- capture bar_items -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'barra' -%}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if bar_items != blank -%}
    <div class="wap-bar" aria-label="Beneficios">
      <div class="wap-bar__track">
        <div class="wap-bar__group">{{ bar_items }}</div>
        <div class="wap-bar__group" aria-hidden="true">{{ bar_items }}</div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ===== TARJETAS DE BENEFICIOS ===== {%- endcomment -%}
  {%- capture cards -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'tarjeta' -%}
        <div class="wap-card{% if block.settings.image %} wap-card--image{% endif %}" data-wap-reveal style="--wap-delay: {{ forloop.index0 | modulo: 4 | times: 120 }}ms;" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 70vw', class: 'wap-card__img' }}
          {%- elsif block.settings.icon != blank -%}
            <span class="wap-card__icon" aria-hidden="true">{{ block.settings.icon }}</span>
          {%- endif -%}
          <div class="wap-card__body">
            <p class="wap-card__title">{{ block.settings.title }}</p>
            {%- if block.settings.text != blank -%}<p class="wap-card__text">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if cards != blank -%}
    <div class="wap-wrap wap-block">
      <h2 class="wap-h2" data-wap-reveal>{{ section.settings.cards_heading }}</h2>
      <div class="wap-cards">{{ cards }}</div>
    </div>
  {%- endif -%}

  {%- comment -%} ===== CAJA DE COMPRA ===== {%- endcomment -%}
  <div class="wap-wrap wap-block" id="wap-comprar">
    {%- if product_item == blank -%}
      <p class="wap-empty">Elige tu producto en la configuración de esta sección.</p>
    {%- else -%}
      <div class="wap-buy">
        <div class="wap-gallery" data-wap-reveal>
          <div class="wap-gallery__main">
            {%- assign main_image = variant.featured_image | default: product_item.featured_image -%}
            {%- if main_image -%}
              {{ main_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', alt: product_item.title, data-wap-main: '' }}
            {%- endif -%}
          </div>
          {%- if product_item.images.size > 1 -%}
            <div class="wap-gallery__thumbs">
              {%- for image in product_item.images limit: 6 -%}
                <button type="button" data-wap-thumb="{{ image | image_url: width: 1200 }}" aria-label="Ver imagen {{ forloop.index }}">
                  {{ image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <div class="wap-buy__info" data-wap-reveal style="--wap-delay: 150ms;">
          {%- if section.settings.buy_badge != blank -%}
            <span class="wap-badge">{{ section.settings.buy_badge }}</span>
          {%- endif -%}
          <h2 class="wap-buy__title">{{ product_item.title }}</h2>
          {%- if section.settings.rating_text != blank -%}
            <p class="wap-rating"><span class="wap-stars">★★★★★</span> {{ section.settings.rating_text }}</p>
          {%- endif -%}

          <p class="wap-price">
            <span data-wap-price>{{ variant.price | money }}</span>
            <s data-wap-compare>{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}</s>
          </p>

          {%- if section.settings.buy_text != blank -%}
            <div class="wap-buy__text">{{ section.settings.buy_text }}</div>
          {%- endif -%}

          {%- form 'product', product_item, class: 'wap-form', data-wap-form: '' -%}
            {%- if product_item.has_only_default_variant -%}
              <input type="hidden" name="id" value="{{ variant.id }}" data-wap-variant>
            {%- else -%}
              <label class="wap-label" for="wap-variant-{{ section.id }}">Opción</label>
              <select id="wap-variant-{{ section.id }}" name="id" class="wap-select" data-wap-variant>
                {%- for v in product_item.variants -%}
                  {%- assign v_image = '' -%}
                  {%- if v.featured_image -%}
                    {%- assign v_image = v.featured_image | image_url: width: 1200 -%}
                  {%- endif -%}
                  <option
                    value="{{ v.id }}"
                    data-price="{{ v.price }}"
                    data-compare="{{ v.compare_at_price }}"
                    data-image="{{ v_image }}"
                    {% unless v.available %}disabled{% endunless %}
                    {% if v.id == variant.id %}selected{% endif %}
                  >
                    {{ v.title }}{% unless v.available %} — Agotado{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}

            <div class="wap-buy__row">
              <div class="wap-qty">
                <button type="button" data-wap-step="-1" aria-label="Quitar uno">−</button>
                <input type="number" name="quantity" value="1" min="1" max="99" data-wap-qty aria-label="Cantidad">
                <button type="button" data-wap-step="1" aria-label="Agregar uno">+</button>
              </div>
              <button type="submit" class="wap-btn wap-btn--ghost" {% unless variant.available %}disabled{% endunless %}>
                Agregar al carrito
              </button>
            </div>

            <a class="wap-btn wap-btn--full" href="{{ routes.cart_url }}/{{ variant.id }}:1" data-wap-buy data-cart-url="{{ routes.cart_url }}">{{ section.settings.buy_button }}</a>
          {%- endform -%}

          <ul class="wap-trust">
            {%- if section.settings.trust_1 != blank -%}<li><span aria-hidden="true">🚚</span>{{ section.settings.trust_1 }}</li>{%- endif -%}
            {%- if section.settings.trust_2 != blank -%}<li><span aria-hidden="true">↩️</span>{{ section.settings.trust_2 }}</li>{%- endif -%}
            {%- if section.settings.trust_3 != blank -%}<li><span aria-hidden="true">🔒</span>{{ section.settings.trust_3 }}</li>{%- endif -%}
          </ul>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} ===== COMO SE APLICA (PASOS) ===== {%- endcomment -%}
  {%- capture steps -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'paso' -%}
        <li class="wap-step" data-wap-reveal style="--wap-delay: {{ forloop.index0 | modulo: 3 | times: 150 }}ms;" {{ block.shopify_attributes }}>
          <span class="wap-step__num" aria-hidden="true"></span>
          <p class="wap-step__title">{{ block.settings.title }}</p>
          <p class="wap-step__text">{{ block.settings.text }}</p>
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if steps != blank -%}
    <div class="wap-wrap wap-block">
      <h2 class="wap-h2 wap-center" data-wap-reveal>{{ section.settings.steps_heading }}</h2>
      <ol class="wap-steps">{{ steps }}</ol>
    </div>
  {%- endif -%}

  {%- comment -%} ===== RESENAS (solo reales) ===== {%- endcomment -%}
  {%- capture reviews -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'resena' and block.settings.text != blank -%}
        <article class="wap-review" data-wap-reveal {{ block.shopify_attributes }}>
          <div class="wap-review__head">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'wap-review__avatar' }}
            {%- endif -%}
            <div>
              <p class="wap-review__name">{{ block.settings.name }}</p>
              {%- if block.settings.verified -%}<p class="wap-review__meta">Compra verificada</p>{%- endif -%}
            </div>
            <span class="wap-stars">{% for i in (1..block.settings.stars) %}★{% endfor %}</span>
          </div>
          {%- if block.settings.title != blank -%}<p class="wap-review__title">{{ block.settings.title }}</p>{%- endif -%}
          <div class="wap-review__text">{{ block.settings.text }}</div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if reviews != blank -%}
    <div class="wap-wrap wap-block">
      <h2 class="wap-h2" data-wap-reveal>{{ section.settings.reviews_heading }}</h2>
      <div class="wap-reviews">{{ reviews }}</div>
    </div>
  {%- endif -%}

  {%- comment -%} ===== COMPARACION ===== {%- endcomment -%}
  {%- capture rows -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'comparacion' -%}
        <div class="wap-compare__row" {{ block.shopify_attributes }}>
          <div class="wap-compare__feature">{{ block.settings.feature }}</div>
          <div class="wap-compare__us">
            <span class="wap-compare__icon">{% if block.settings.us %}✓{% else %}✕{% endif %}</span>
            {%- if block.settings.us_note != blank -%}<small>{{ block.settings.us_note }}</small>{%- endif -%}
          </div>
          <div class="wap-compare__them">
            <span class="wap-compare__icon">{% if block.settings.them %}✓{% else %}✕{% endif %}</span>
            {%- if block.settings.them_note != blank -%}<small>{{ block.settings.them_note }}</small>{%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if rows != blank -%}
    <div class="wap-soft-bg">
      <div class="wap-wrap wap-block">
        <h2 class="wap-h2 wap-center" data-wap-reveal>{{ section.settings.compare_heading }}</h2>
        <div class="wap-compare" data-wap-reveal>
          <div class="wap-compare__row wap-compare__row--head">
            <div></div>
            <div class="wap-compare__us">{{ section.settings.compare_us }}</div>
            <div class="wap-compare__them">{{ section.settings.compare_them }}</div>
          </div>
          {{ rows }}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ===== PREGUNTAS FRECUENTES ===== {%- endcomment -%}
  {%- assign faq_open = true -%}
  {%- capture faqs -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'pregunta' -%}
        <details class="wap-faq__item" {{ block.shopify_attributes }} {% if faq_open %}open{% endif %}>
          {%- assign faq_open = false -%}
          <summary>{{ block.settings.question }}</summary>
          <div class="wap-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if faqs != blank -%}
    <div class="wap-wrap wap-block wap-faq">
      <div data-wap-reveal>
        <h2 class="wap-h2">{{ section.settings.faq_heading }}</h2>
        {%- if section.settings.faq_text != blank -%}<div class="wap-faq__intro">{{ section.settings.faq_text }}</div>{%- endif -%}
      </div>
      <div class="wap-faq__list" data-wap-reveal style="--wap-delay: 150ms;">{{ faqs }}</div>
    </div>
  {%- endif -%}

  {%- comment -%} ===== LLAMADO FINAL ===== {%- endcomment -%}
  {%- if section.settings.final_heading != blank -%}
    <div class="wap-final">
      <div class="wap-wrap wap-final__inner" data-wap-reveal>
        <h2 class="wap-final__title">{{ section.settings.final_heading }}</h2>
        {%- if section.settings.final_text != blank -%}<div class="wap-final__text">{{ section.settings.final_text }}</div>{%- endif -%}
        <a class="wap-btn wap-btn--light" href="#wap-comprar">{{ section.settings.buy_button }}</a>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ===== BOTON FIJO EN MOVIL ===== {%- endcomment -%}
  {%- if product_item != blank -%}
    <div class="wap-sticky" data-wap-sticky>
      <span class="wap-sticky__price" data-wap-sticky-price>{{ variant.price | money }}</span>
      <a class="wap-btn" href="#wap-comprar">{{ section.settings.buy_button }}</a>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .wap {
    --wap-text: #2a1f23;
    --wap-muted: #7a6a70;
    --wap-border: #f0e4e8;
    --wap-ease: cubic-bezier(0.22, 1, 0.36, 1);
    color: var(--wap-text);
    overflow-x: clip;
  }
  .wap *,
  .wap *::before,
  .wap *::after {
    box-sizing: border-box;
  }
  .wap-wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .wap-block {
    padding-top: 80px;
  }
  .wap-h2 {
    margin: 0 0 32px;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;
  }
  .wap-center {
    text-align: center;
  }

  /* Botones */
  .wap-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    border: 2px solid var(--wap-accent);
    border-radius: 999px;
    background: var(--wap-accent);
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 10px 24px -12px var(--wap-accent);
    transition: transform 0.6s var(--wap-ease), box-shadow 0.6s var(--wap-ease), background 0.4s ease;
  }
  .wap-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 32px -14px var(--wap-accent);
  }
  .wap-btn--full {
    width: 100%;
    margin-top: 12px;
    font-size: 17px;
  }
  .wap-btn--ghost {
    flex: 1;
    background: #fff;
    color: var(--wap-accent);
    box-shadow: none;
  }
  .wap-btn--light {
    border-color: #fff;
    background: #fff;
    color: var(--wap-dark);
  }
  .wap-btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .wap-stars {
    color: #f5b301;
    letter-spacing: 1px;
  }
  .wap-rating {
    margin: 0 0 12px;
    font-size: 13px;
  }
  .wap-eyebrow {
    display: inline-block;
    margin: 0 0 16px;
    padding: 6px 14px;
    border-radius: 999px;
    background: #fff;
    color: var(--wap-dark);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .wap-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }
  .wap-checks li::before {
    content: '✓';
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-right: 6px;
    border-radius: 50%;
    background: var(--wap-accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
  }

  /* Portada */
  .wap-hero {
    position: relative;
    overflow: hidden;
    padding: 72px 0 88px;
    background:
      radial-gradient(circle at 85% 20%, #fff 0, transparent 40%),
      linear-gradient(160deg, var(--wap-soft) 0%, #fff 100%);
  }
  .wap-hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .wap-hero__title {
    margin: 0 0 18px;
    color: var(--wap-text);
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
  }
  .wap-hero__text {
    max-width: 480px;
    margin-bottom: 28px;
    color: var(--wap-muted);
    font-size: 17px;
  }
  .wap-hero__text p {
    margin: 0;
  }
  .wap-hero__actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .wap-hero__price {
    font-size: 22px;
    font-weight: 700;
  }
  .wap-hero__media {
    position: relative;
  }
  .wap-hero__frame {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 40% 40% 32px 32px;
    background: #fff;
    box-shadow: 0 40px 80px -40px rgba(201, 77, 110, 0.55);
    animation: wap-float 9s ease-in-out infinite;
  }
  .wap-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    animation: wap-zoom 18s ease-in-out infinite alternate;
  }
  .wap-bubble {
    position: absolute;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.15) 60%);
    box-shadow: inset -4px -6px 12px rgba(232, 106, 138, 0.18);
    animation: wap-rise 16s ease-in-out infinite;
    pointer-events: none;
  }
  .wap-bubble--1 { width: 70px; height: 70px; left: 6%; bottom: 10%; }
  .wap-bubble--2 { width: 28px; height: 28px; left: 44%; top: 14%; animation-delay: -4s; animation-duration: 20s; }
  .wap-bubble--3 { width: 46px; height: 46px; right: 6%; bottom: 18%; animation-delay: -8s; animation-duration: 18s; }
  .wap-bubble--4 { width: 18px; height: 18px; right: 40%; bottom: 8%; animation-delay: -2s; animation-duration: 14s; }

  @keyframes wap-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-16px) rotate(-1deg); }
  }
  @keyframes wap-zoom {
    to { transform: scale(1.12); }
  }
  @keyframes wap-rise {
    0%, 100% { transform: translateY(0); opacity: 0.9; }
    50% { transform: translateY(-40px); opacity: 0.5; }
  }

  /* Barra */
  .wap-bar {
    overflow: hidden;
    background: var(--wap-dark);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .wap-bar__track {
    display: flex;
    width: max-content;
    animation: wap-marquee 60s linear infinite;
  }
  .wap-bar__group {
    display: flex;
  }
  .wap-bar__group span {
    padding: 15px 36px;
    white-space: nowrap;
  }
  .wap-bar__group span::before {
    content: '✦';
    margin-right: 36px;
    opacity: 0.6;
  }
  @keyframes wap-marquee {
    to { transform: translateX(-50%); }
  }

  /* Tarjetas */
  .wap-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .wap-card {
    position: relative;
    overflow: hidden;
    padding: 28px 22px;
    border-radius: 24px;
    background: var(--wap-soft);
    transition: transform 0.8s var(--wap-ease), box-shadow 0.8s var(--wap-ease);
  }
  .wap-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 40px -28px rgba(0, 0, 0, 0.35);
  }
  .wap-card--image {
    min-height: 340px;
    padding: 0;
  }
  .wap-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--wap-ease);
  }
  .wap-card--image:hover .wap-card__img {
    transform: scale(1.08);
  }
  .wap-card--image .wap-card__body {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 12px 16px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.92);
  }
  .wap-card__icon {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    margin-bottom: 18px;
    border-radius: 50%;
    background: #fff;
    font-size: 28px;
  }
  .wap-card__title {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 700;
  }
  .wap-card__text {
    margin: 0;
    color: var(--wap-muted);
    font-size: 14px;
  }

  /* Compra */
  .wap-buy {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .wap-gallery__main {
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 28px;
    background: var(--wap-soft);
  }
  .wap-gallery__main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--wap-ease);
  }
  .wap-gallery__main:hover img {
    transform: scale(1.06);
  }
  .wap-gallery__thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    overflow-x: auto;
  }
  .wap-gallery__thumbs button {
    flex: 0 0 70px;
    height: 70px;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 14px;
    background: none;
    cursor: pointer;
  }
  .wap-gallery__thumbs button.is-active {
    border-color: var(--wap-accent);
  }
  .wap-gallery__thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wap-badge {
    display: inline-block;
    margin-bottom: 12px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--wap-soft);
    color: var(--wap-dark);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .wap-buy__title {
    margin: 0 0 10px;
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.05;
  }
  .wap-price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 8px 0 16px;
    font-size: 30px;
    font-weight: 700;
  }
  .wap-price s {
    color: var(--wap-muted);
    font-size: 17px;
    font-weight: 400;
  }
  .wap-buy__text {
    margin-bottom: 22px;
    color: var(--wap-muted);
    font-size: 16px;
  }
  .wap-label {
    display: block;
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 600;
  }
  .wap-select {
    width: 100%;
    height: 48px;
    margin-bottom: 12px;
    padding: 0 14px;
    border: 1px solid var(--wap-border);
    border-radius: 14px;
    background: #fff;
    font: inherit;
  }
  .wap-buy__row {
    display: flex;
    gap: 12px;
  }
  .wap-qty {
    display: inline-flex;
    align-items: center;
    border: 2px solid var(--wap-border);
    border-radius: 999px;
  }
  .wap-qty button {
    width: 44px;
    height: 48px;
    border: 0;
    background: none;
    font-size: 20px;
    cursor: pointer;
  }
  .wap-qty input {
    width: 36px;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    text-align: center;
    -moz-appearance: textfield;
  }
  .wap-qty input::-webkit-inner-spin-button {
    -webkit-appearance: none;
  }
  .wap-trust {
    display: grid;
    gap: 10px;
    margin: 24px 0 0;
    padding: 18px;
    border-radius: 18px;
    background: var(--wap-soft);
    list-style: none;
    font-size: 14px;
  }
  .wap-trust li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .wap-empty {
    padding: 40px;
    border: 1px dashed var(--wap-border);
    border-radius: 18px;
    text-align: center;
  }

  /* Pasos */
  .wap-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: wap-step;
  }
  .wap-step {
    padding: 32px 26px;
    border: 1px solid var(--wap-border);
    border-radius: 24px;
    background: #fff;
    text-align: center;
    counter-increment: wap-step;
  }
  .wap-step__num::before {
    content: counter(wap-step);
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: 0 auto 16px;
    border-radius: 50%;
    background: var(--wap-accent);
    color: #fff;
    font-size: 22px;
    font-weight: 700;
  }
  .wap-step__title {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 700;
  }
  .wap-step__text {
    margin: 0;
    color: var(--wap-muted);
  }

  /* Resenas */
  .wap-reviews {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }
  .wap-review {
    padding: 22px;
    border: 1px solid var(--wap-border);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 10px 30px -20px rgba(0, 0, 0, 0.2);
  }
  .wap-review__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .wap-review__head > div {
    flex: 1;
  }
  .wap-review__avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
  }
  .wap-review__name,
  .wap-review__meta,
  .wap-review__title {
    margin: 0;
  }
  .wap-review__name,
  .wap-review__title {
    font-weight: 700;
  }
  .wap-review__meta {
    color: var(--wap-muted);
    font-size: 12px;
  }
  .wap-review__text {
    color: var(--wap-muted);
    font-size: 14px;
  }

  /* Comparacion */
  .wap-soft-bg {
    margin-top: 80px;
    padding-bottom: 80px;
    background: var(--wap-soft);
  }
  .wap-compare {
    max-width: 780px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 30px 60px -40px rgba(201, 77, 110, 0.5);
  }
  .wap-compare__row {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    border-top: 1px solid var(--wap-border);
  }
  .wap-compare__row > div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 16px;
    font-size: 15px;
  }
  .wap-compare__row--head {
    border-top: 0;
    font-weight: 700;
  }
  .wap-compare__us,
  .wap-compare__them {
    align-items: center;
    text-align: center;
  }
  .wap-compare__us {
    background: var(--wap-accent);
    color: #fff;
  }
  .wap-compare__them small,
  .wap-compare__them .wap-compare__icon {
    color: var(--wap-muted);
  }
  .wap-compare__icon {
    font-size: 20px;
    font-weight: 700;
  }

  /* Preguntas */
  .wap-faq {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
    padding-bottom: 80px;
  }
  .wap-faq__intro {
    color: var(--wap-muted);
  }
  .wap-faq__item {
    border-bottom: 1px solid var(--wap-border);
  }
  .wap-faq__item summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font-size: 17px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  .wap-faq__item summary::-webkit-details-marker {
    display: none;
  }
  .wap-faq__item summary::after {
    content: '+';
    flex-shrink: 0;
    color: var(--wap-accent);
    font-size: 24px;
    line-height: 1;
    transition: transform 0.6s var(--wap-ease);
  }
  .wap-faq__item[open] summary::after {
    transform: rotate(45deg);
  }
  .wap-faq__answer {
    padding-bottom: 20px;
    color: var(--wap-muted);
    animation: wap-fade 0.9s var(--wap-ease);
  }
  .wap-faq__answer p {
    margin: 0 0 8px;
  }
  @keyframes wap-fade {
    from { opacity: 0; transform: translateY(-6px); }
  }

  /* Llamado final */
  .wap-final {
    padding: 80px 0;
    background: linear-gradient(135deg, var(--wap-accent), var(--wap-dark));
    color: #fff;
    text-align: center;
  }
  .wap-final__title {
    margin: 0 0 12px;
    color: #fff;
    font-size: clamp(30px, 4.5vw, 52px);
    line-height: 1.05;
  }
  .wap-final__text {
    max-width: 520px;
    margin: 0 auto 28px;
    opacity: 0.9;
  }
  .wap-final__text p {
    margin: 0;
  }

  /* Animacion lenta al hacer scroll */
  .wap.wap--animate [data-wap-reveal] {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1.4s var(--wap-ease), transform 1.4s var(--wap-ease);
    transition-delay: var(--wap-delay, 0ms);
  }
  .wap.wap--animate [data-wap-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  /* Boton fijo movil */
  .wap-sticky {
    display: none;
  }

  @media (max-width: 989px) {
    .wap-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 749px) {
    .wap-block {
      padding-top: 56px;
    }
    .wap-hero {
      padding: 32px 0 56px;
    }
    .wap-hero__grid,
    .wap-buy,
    .wap-faq,
    .wap-steps {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .wap-hero__media {
      order: -1;
      max-width: 420px;
      margin: 0 auto;
    }
    .wap-cards {
      gap: 12px;
    }
    .wap-card {
      padding: 20px 16px;
    }
    .wap-compare__row {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
    .wap-compare__row > div {
      padding: 12px 8px;
      font-size: 13px;
    }
    .wap-soft-bg {
      margin-top: 56px;
      padding-bottom: 56px;
    }
    .wap-sticky {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 16px;
      border-top: 1px solid var(--wap-border);
      background: #fff;
      transform: translateY(100%);
      transition: transform 0.6s var(--wap-ease);
    }
    .wap-sticky.is-visible {
      transform: none;
    }
    .wap-sticky .wap-btn {
      padding: 12px 24px;
    }
    .wap-sticky__price {
      font-size: 20px;
      font-weight: 700;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wap *,
    .wap *::before {
      animation: none !important;
      transition: none !important;
    }
    .wap.wap--animate [data-wap-reveal] {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-wap]').forEach((root) => {
    // Aparicion lenta de los elementos al hacer scroll
    const reveals = root.querySelectorAll('[data-wap-reveal]');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('wap--animate');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach((el) => observer.observe(el));
    }

    const form = root.querySelector('[data-wap-form]');
    if (!form) return;

    const money = (cents) =>
      new Intl.NumberFormat(root.dataset.locale, { style: 'currency', currency: root.dataset.currency }).format(cents / 100);

    const variantInput = form.querySelector('[data-wap-variant]');
    const qtyInput = form.querySelector('[data-wap-qty]');
    const buy = form.querySelector('[data-wap-buy]');
    const mainImage = root.querySelector('[data-wap-main]');
    const stickyPrice = root.querySelector('[data-wap-sticky-price]');

    // "Comprar ahora": enlace de carrito que lleva directo al checkout
    function update() {
      const qty = Math.max(1, Math.min(99, parseInt(qtyInput.value, 10) || 1));
      qtyInput.value = qty;
      buy.href = `${buy.dataset.cartUrl}/${variantInput.value}:${qty}`;
    }

    form.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-wap-step]');
      if (!btn) return;
      qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + Number(btn.dataset.wapStep);
      update();
    });
    qtyInput.addEventListener('change', update);

    if (variantInput.tagName === 'SELECT') {
      variantInput.addEventListener('change', () => {
        const option = variantInput.selectedOptions[0];
        const price = Number(option.dataset.price) || 0;
        const compare = Number(option.dataset.compare) || 0;
        root.querySelector('[data-wap-price]').textContent = money(price);
        root.querySelector('[data-wap-compare]').textContent = compare > price ? money(compare) : '';
        if (stickyPrice) stickyPrice.textContent = money(price);
        if (option.dataset.image && mainImage) {
          mainImage.src = option.dataset.image;
          mainImage.removeAttribute('srcset');
        }
        update();
      });
    }

    root.querySelectorAll('[data-wap-thumb]').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        if (!mainImage) return;
        mainImage.src = thumb.dataset.wapThumb;
        mainImage.removeAttribute('srcset');
        root.querySelectorAll('[data-wap-thumb]').forEach((t) => t.classList.toggle('is-active', t === thumb));
      });
    });

    // Boton fijo en movil: aparece cuando la caja de compra no esta en pantalla
    const sticky = root.querySelector('[data-wap-sticky]');
    const buyBox = root.querySelector('#wap-comprar');
    if (sticky && buyBox && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        sticky.classList.toggle('is-visible', !entry.isIntersecting);
      }).observe(buyBox);
    }

    update();
  });
{% endjavascript %}

